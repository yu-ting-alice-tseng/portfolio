    <worksheet name="Revenue Share by Category">
        <layout-options>
          <title>
            <formatted-text>
              <run bold='true' fontcolor="#16211f" fontname="Tableau Book" fontsize='11'>Revenue share by category</run>
            </formatted-text>
          </title>
        </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Chocolate Sales" name="federated.choco_main" />
          </datasources>
          <datasource-dependencies datasource="federated.choco_main">
            <column datatype="string" name="[category]" role="dimension" type="nominal" />
            <column caption="Revenue share · Category" datatype="real" default-format="p0.0%" name="[Calc_Part_Cat]" role="measure" type="quantitative">
              <calculation class='tableau' formula="SUM([revenue]) / MIN({EXCLUDE [category] : SUM([revenue])})" />
            </column>
            <column datatype="real" name="[revenue]" role="measure" type="quantitative" />
            <column-instance column="[category]" derivation="None" name="[none:category:nk]" pivot='key' type="nominal" />
            <column-instance column="[Calc_Part_Cat]" derivation="User" name="[usr:Calc_Part_Cat:qk]" pivot='key' type="quantitative" />
            <column-instance column="[revenue]" derivation="Sum" name="[sum:revenue:qk]" pivot='key' type="quantitative" />
          </datasource-dependencies>
          <computed-sort column="[federated.choco_main].[none:category:nk]" direction='DESC' using="[federated.choco_main].[sum:revenue:qk]" />
          <aggregation value='true' />
        </view>
