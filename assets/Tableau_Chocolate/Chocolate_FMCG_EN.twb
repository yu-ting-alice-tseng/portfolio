<?xml version='1.0' encoding='utf-8' ?>
<workbook locale="en_US" source-build='2020.1.0 (20201.20.0220.0623)' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <datasources>
    <datasource caption="Chocolate Sales" inline='true' name="federated.choco_main" version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption="chocolate_tableau" name="textscan.choco_main">
            <connection class='textscan' directory='.' filename="chocolate_tableau.csv" password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection="textscan.choco_main" name="chocolate_tableau.csv" table="[chocolate_tableau#csv]" type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
            <column datatype="integer" name="year" ordinal='0' />
            <column datatype="integer" name="month" ordinal='1' />
            <column datatype="string" name="month_fr" ordinal='2' />
            <column datatype="string" name="month_en" ordinal='3' />
            <column datatype="string" name="channel" ordinal='4' />
            <column datatype="string" name="country_fr" ordinal='5' />
            <column datatype="string" name="country_en" ordinal='6' />
            <column datatype="string" name="product_id" ordinal='7' />
            <column datatype="string" name="product_name" ordinal='8' />
            <column datatype="string" name="brand" ordinal='9' />
            <column datatype="string" name="category" ordinal='10' />
            <column datatype="integer" name="transactions" ordinal='11' />
            <column datatype="integer" name="units" ordinal='12' />
            <column datatype="real" name="revenue" ordinal='13' />
            <column datatype="real" name="cost" ordinal='14' />
            <column datatype="real" name="profit" ordinal='15' />
          </columns>
        </relation>
      </connection>
      <aliases enabled='yes' />
      <column caption="Year" datatype="integer" name="[year]" role="dimension" type="ordinal" />
      <column caption="month" datatype="integer" name="[month]" role="dimension" type="ordinal" hidden='true' />
      <column caption="month_fr" datatype="string" name="[month_fr]" role="dimension" type="nominal" hidden='true' />
      <column caption="Month" datatype="string" name="[month_en]" role="dimension" type="nominal" />
      <column caption="Channel" datatype="string" name="[channel]" role="dimension" type="nominal" />
      <column caption="country_fr" datatype="string" name="[country_fr]" role="dimension" type="nominal" hidden='true' />
      <column caption="Country" datatype="string" name="[country_en]" role="dimension" type="nominal" />
      <column caption="product_id" datatype="string" name="[product_id]" role="dimension" type="nominal" hidden='true' />
      <column caption="Product" datatype="string" name="[product_name]" role="dimension" type="nominal" />
      <column caption="Brand" datatype="string" name="[brand]" role="dimension" type="nominal" />
      <column caption="Category" datatype="string" name="[category]" role="dimension" type="nominal" />
      <column caption="Transactions" datatype="integer" default-format="n#,##0" name="[transactions]" role="measure" type="quantitative" />
      <column caption="Units" datatype="integer" default-format="n#,##0" name="[units]" role="measure" type="quantitative" />
      <column caption="Revenue ($)" datatype="real" default-format="n#,##0" name="[revenue]" role="measure" type="quantitative" />
      <column caption="Cost ($)" datatype="real" default-format="n#,##0" name="[cost]" role="measure" type="quantitative" />
      <column caption="Margin ($)" datatype="real" default-format="n#,##0" name="[profit]" role="measure" type="quantitative" />
      <column caption="Revenue ($M)" datatype="real" default-format="n#,##0.0" name="[Calc_CA_M]" role="measure" type="quantitative">
        <calculation class='tableau' formula="SUM([revenue]) / 1000000" />
      </column>
      <column caption="Gross margin" datatype="real" default-format="p0.0%" name="[Calc_Marge]" role="measure" type="quantitative">
        <calculation class='tableau' formula="SUM([profit]) / SUM([revenue])" />
      </column>
      <column caption="Average order value ($)" datatype="real" default-format="n#,##0.00" name="[Calc_AOV]" role="measure" type="quantitative">
        <calculation class='tableau' formula="SUM([revenue]) / SUM([transactions])" />
      </column>
      <column caption="Units per transaction" datatype="real" default-format="n#,##0.00" name="[Calc_UPT]" role="measure" type="quantitative">
        <calculation class='tableau' formula="SUM([units]) / SUM([transactions])" />
      </column>
      <column caption="Revenue share · Channel" datatype="real" default-format="p0.0%" name="[Calc_Part_Canal]" role="measure" type="quantitative">
        <calculation class='tableau' formula="SUM([revenue]) / MIN({EXCLUDE [channel] : SUM([revenue])})" />
      </column>
      <column caption="Revenue share · Country" datatype="real" default-format="p0.0%" name="[Calc_Part_Pays]" role="measure" type="quantitative">
        <calculation class='tableau' formula="SUM([revenue]) / MIN({EXCLUDE [country_en] : SUM([revenue])})" />
      </column>
      <column caption="Revenue share · Category" datatype="real" default-format="p0.0%" name="[Calc_Part_Cat]" role="measure" type="quantitative">
        <calculation class='tableau' formula="SUM([revenue]) / MIN({EXCLUDE [category] : SUM([revenue])})" />
      </column>
      <column caption="Seasonality index" datatype="real" default-format="n#,##0.0" name="[Calc_Index]" role="measure" type="quantitative">
        <calculation class='tableau' formula="SUM([revenue]) / (MIN({EXCLUDE [month_en] : SUM([revenue])}) / 12) * 100" />
      </column>
      <column caption="Gap to average (pts)" datatype="real" default-format="n+#,##0.0;-#,##0.0" name="[Calc_Ecart]" role="measure" type="quantitative">
        <calculation class='tableau' formula="[Calc_Index] - 100" />
      </column>
      <column caption="Position" datatype="string" name="[Calc_Sign]" role="dimension" type="nominal">
        <calculation class='tableau' formula='IF [Calc_Ecart] &gt;= 0 THEN "Above average" ELSE "Below average" END' />
      </column>
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[usr:Calc_Sign:nk]' type='palette'>
            <map to="#0d9488">
              <bucket>"Above average"</bucket>
            </map>
            <map to="#9fcfc9">
              <bucket>"Below average"</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
    </datasource>
    <datasource caption="Chocolate Pareto" inline='true' name="federated.choco_pareto" version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption="chocolate_pareto" name="textscan.choco_pareto">
            <connection class='textscan' directory='.' filename="chocolate_pareto.csv" password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection="textscan.choco_pareto" name="chocolate_pareto.csv" table="[chocolate_pareto#csv]" type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
            <column datatype="integer" name="rank" ordinal='0' />
            <column datatype="string" name="product_id" ordinal='1' />
            <column datatype="string" name="product_name" ordinal='2' />
            <column datatype="real" name="revenue" ordinal='3' />
            <column datatype="real" name="share" ordinal='4' />
            <column datatype="real" name="cum_share" ordinal='5' />
          </columns>
        </relation>
      </connection>
      <aliases enabled='yes' />
      <column caption="SKU rank" datatype="integer" default-format="n#,##0" name="[rank]" role="dimension" type="quantitative" />
      <column caption="product_id" datatype="string" name="[product_id]" role="dimension" type="nominal" hidden='true' />
      <column caption="Product" datatype="string" name="[product_name]" role="dimension" type="nominal" />
      <column caption="Revenue ($)" datatype="real" default-format="n#,##0" name="[revenue]" role="measure" type="quantitative" />
      <column caption="Revenue share" datatype="real" default-format="p0.00%" name="[share]" role="measure" type="quantitative" />
      <column caption="Cumulative revenue share" datatype="real" default-format="p0.0%" name="[cum_share]" role="measure" type="quantitative" />
    </datasource>
  </datasources>
  <shared-views>
    <shared-view name="federated.choco_main">
      <datasources>
        <datasource caption='Chocolate Sales' name="federated.choco_main" />
      </datasources>
      <datasource-dependencies datasource="federated.choco_main">
        <column datatype='string' name="[channel]" role='dimension' type='nominal' />
        <column datatype='string' name="[country_en]" role='dimension' type='nominal' />
        <column datatype='string' name="[category]" role='dimension' type='nominal' />
        <column-instance column="[channel]" derivation='None' name="[none:channel:nk]" pivot='key' type='nominal' />
        <column-instance column="[country_en]" derivation='None' name="[none:country_en:nk]" pivot='key' type='nominal' />
        <column-instance column="[category]" derivation='None' name="[none:category:nk]" pivot='key' type='nominal' />
      </datasource-dependencies>
      <filter class='categorical' column="[federated.choco_main].[none:channel:nk]">
        <groupfilter function='level-members' level="[none:channel:nk]" user:ui-enumeration='all' user:ui-marker='enumerate' />
      </filter>
      <filter class='categorical' column="[federated.choco_main].[none:country_en:nk]">
        <groupfilter function='level-members' level="[none:country_en:nk]" user:ui-enumeration='all' user:ui-marker='enumerate' />
      </filter>
      <filter class='categorical' column="[federated.choco_main].[none:category:nk]">
        <groupfilter function='level-members' level="[none:category:nk]" user:ui-enumeration='all' user:ui-marker='enumerate' />
      </filter>
    </shared-view>
  </shared-views>
  <worksheets>
    <worksheet name="KPI · Revenue">
        <layout-options>
          <title>
            <formatted-text>
              <run bold='true' fontcolor="#16211f" fontname="Tableau Book" fontsize='11'>Revenue ($M)</run>
            </formatted-text>
          </title>
        </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Chocolate Sales" name="federated.choco_main" />
          </datasources>
          <datasource-dependencies datasource="federated.choco_main">
            <column caption="Revenue ($M)" datatype="real" default-format="n#,##0.0" name="[Calc_CA_M]" role="measure" type="quantitative">
              <calculation class='tableau' formula="SUM([revenue]) / 1000000" />
            </column>
            <column-instance column="[Calc_CA_M]" derivation="User" name="[usr:Calc_CA_M:qk]" pivot='key' type="quantitative" />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='color' value="#44524f" />
            <format attr='font-family' value="Tableau Book" />
          </style-rule>
          <style-rule element='label'>
            <format attr='color' value="#16211f" />
            <format attr='font-family' value="Tableau Book" />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' value='off' />
          </style-rule>
          <style-rule element='table'>
            <format attr='background-color' value="#eef3ef" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[federated.choco_main].[usr:Calc_CA_M:qk]" />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-color' value="#0d9488" />
              </style-rule>
              <style-rule element='cell'>
                <format attr='font-size' value='26' />
                <format attr='color' value="#0f766e" />
                <format attr='text-align' value='center' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
      <simple-id uuid="{BE6F2F7A-9D4D-541F-AE00-A7B539E2C4ED}" />
    </worksheet>
