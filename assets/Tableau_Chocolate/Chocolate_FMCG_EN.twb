    <worksheet name="Seasonality">
        <layout-options>
          <title>
            <formatted-text>
              <run fontcolor="#3A332C" fontname="Constantia" fontsize="16">Seasonality index (100 = average month): no peak in February or December</run>
            </formatted-text>
          </title>
        </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Chocolate Sales" name="federated.choco_main" />
          </datasources>
          <datasource-dependencies datasource="federated.choco_main">
            <column datatype="string" name="[month_en]" role="dimension" type="nominal" />
            <column caption="Seasonality index" datatype="real" default-format="n#,##0.0" name="[Calc_Index]" role="measure" type="quantitative">
              <calculation class='tableau' formula="SUM([revenue]) / (MIN({EXCLUDE [month_en] : SUM([revenue])}) / 12) * 100" />
            </column>
            <column caption="Gap to average (pts)" datatype="real" default-format="n+#,##0.0;-#,##0.0" name="[Calc_Ecart]" role="measure" type="quantitative">
              <calculation class='tableau' formula="[Calc_Index] - 100" />
            </column>
            <column datatype="integer" name="[month]" role="dimension" type="ordinal" />
            <column-instance column="[month_en]" derivation="None" name="[none:month_en:nk]" pivot='key' type="nominal" />
            <column-instance column="[Calc_Index]" derivation="User" name="[usr:Calc_Index:qk]" pivot='key' type="quantitative" />
            <column-instance column="[Calc_Ecart]" derivation="User" name="[usr:Calc_Ecart:qk]" pivot='key' type="quantitative" />
            <column-instance column="[month]" derivation="Min" name="[min:month:qk]" pivot='key' type="quantitative" />
          </datasource-dependencies>
          <sort class='computed' column="[federated.choco_main].[none:month_en:nk]" direction='ASC' using="[federated.choco_main].[min:month:qk]" />
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='color' value="#8C8279" />
            <format attr='font-family' value="Corbel" />
            <format attr='font-size' value='11' />
          </style-rule>
          <style-rule element='label'>
            <format attr='color' value="#3A332C" />
            <format attr='font-family' value="Corbel" />
            <format attr='font-size' value='11' />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' value='off' />
