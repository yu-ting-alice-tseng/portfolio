    <worksheet name="Seasonality">
        <layout-options>
          <title>
            <formatted-text>
              <run bold='true' fontcolor="#16211f" fontname="Tableau Book" fontsize='11'>Seasonality index (100 = average month): no peak in February or December</run>
            </formatted-text>
          </title>
        </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Chocolate Sales" name="federated.choco_main" />
          </datasources>
          <datasource-dependencies datasource="federated.choco_main">
            <column datatype="string" name="[month_en]" role="dimension" type="nominal" />
            <column caption="Seasonality index" datatype="real" default-format="n#,##0.0" name="[Calc_Index]" role="measure" type="quantitative">
              <calculation class='tableau' formula="SUM([revenue]) / (MIN({EXCLUDE [month_en] : SUM([revenue])}) / 12) * 100" />
            </column>
            <column caption="Gap to average (pts)" datatype="real" default-format="n+#,##0.0;-#,##0.0" name="[Calc_Ecart]" role="measure" type="quantitative">
              <calculation class='tableau' formula="[Calc_Index] - 100" />
            </column>
            <column caption="Position" datatype="string" name="[Calc_Sign]" role="dimension" type="nominal">
              <calculation class='tableau' formula='IF [Calc_Ecart] &gt;= 0 THEN "Above average" ELSE "Below average" END' />
            </column>
            <column-instance column="[month_en]" derivation="None" name="[none:month_en:nk]" pivot='key' type="nominal" />
            <column-instance column="[Calc_Index]" derivation="User" name="[usr:Calc_Index:qk]" pivot='key' type="quantitative" />
            <column-instance column="[Calc_Ecart]" derivation="User" name="[usr:Calc_Ecart:qk]" pivot='key' type="quantitative" />
            <column-instance column="[Calc_Sign]" derivation="User" name="[usr:Calc_Sign:nk]" pivot='key' type="nominal" />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='color' value="#44524f" />
            <format attr='font-family' value="Tableau Book" />
          </style-rule>
          <style-rule element='label'>
            <format attr='color' value="#16211f" />
            <format attr='font-family' value="Tableau Book" />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' value='off' />
          </style-rule>
          <style-rule element='table'>
            <format attr='background-color' value="#eef3ef" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class="Bar" />
            <encodings>
              <color column="[federated.choco_main].[usr:Calc_Sign:nk]" />
              <text column="[federated.choco_main].[usr:Calc_Index:qk]" />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.choco_main].[usr:Calc_Ecart:qk]</rows>
        <cols>[federated.choco_main].[none:month_en:nk]</cols>
      </table>
      <simple-id uuid="{84D4707D-81BF-5495-B24D-17DAD2CE6B17}" />
    </worksheet>
    <worksheet name="Pareto Curve">
        <layout-options>
          <title>
            <formatted-text>
              <run bold='true' fontcolor="#16211f" fontname="Tableau Book" fontsize='11'>Pareto curve: 160 of 200 SKUs to reach 80% of revenue</run>
            </formatted-text>
          </title>
        </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Chocolate Pareto" name="federated.choco_pareto" />
          </datasources>
          <datasource-dependencies datasource="federated.choco_pareto">
            <column datatype="integer" name="[rank]" role="dimension" type="quantitative" />
            <column datatype="real" name="[cum_share]" role="measure" type="quantitative" />
            <column datatype="string" name="[product_name]" role="dimension" type="nominal" />
            <column-instance column="[rank]" derivation="None" name="[none:rank:qk]" pivot='key' type="quantitative" />
            <column-instance column="[cum_share]" derivation="Sum" name="[sum:cum_share:qk]" pivot='key' type="quantitative" />
            <column-instance column="[product_name]" derivation="None" name="[none:product_name:nk]" pivot='key' type="nominal" />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='color' value="#44524f" />
            <format attr='font-family' value="Tableau Book" />
          </style-rule>
          <style-rule element='label'>
            <format attr='color' value="#16211f" />
            <format attr='font-family' value="Tableau Book" />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' value='off' />
          </style-rule>
          <style-rule element='table'>
            <format attr='background-color' value="#eef3ef" />
          </style-rule>
        </style>
