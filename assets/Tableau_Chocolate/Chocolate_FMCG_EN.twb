            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-color' value="#9A7650" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.choco_main].[min:sku_cum_share:qk]</rows>
        <cols>[federated.choco_main].[none:sku_rank:qk]</cols>
      </table>
