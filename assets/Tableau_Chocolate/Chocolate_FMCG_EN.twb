            <column datatype="string" name="[channel]" role="dimension" type="nominal" />
            <column caption="Average order value ($)" datatype="real" default-format="n#,##0.00" name="[Calc_AOV]" role="measure" type="quantitative">
              <calculation class='tableau' formula="SUM([revenue]) / SUM([transactions])" />
