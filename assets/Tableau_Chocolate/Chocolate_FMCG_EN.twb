          </datasources>
          <datasource-dependencies datasource="federated.choco_main">
            <column datatype="string" name="[channel]" role="dimension" type="nominal" />
            <column caption="Revenue share · Channel" datatype="real" default-format="p0.0%" name="[Calc_Part_Canal]" role="measure" type="quantitative">
              <calculation class='tableau' formula="SUM([revenue]) / MIN({EXCLUDE [channel] : SUM([revenue])})" />
            </column>
            <column datatype="real" name="[revenue]" role="measure" type="quantitative" />
            <column-instance column="[channel]" derivation="None" name="[none:channel:nk]" pivot='key' type="nominal" />
            <column-instance column="[Calc_Part_Canal]" derivation="User" name="[usr:Calc_Part_Canal:qk]" pivot='key' type="quantitative" />
            <column-instance column="[revenue]" derivation="Sum" name="[sum:revenue:qk]" pivot='key' type="quantitative" />
          </datasource-dependencies>
          <computed-sort column="[federated.choco_main].[none:channel:nk]" direction='DESC' using="[federated.choco_main].[sum:revenue:qk]" />
