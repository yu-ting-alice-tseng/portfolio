	column Segment =
			
			VAR mr = CALCULATE ( MEDIAN ( product_info[Rating] ), ALL ( product_info ) )
			VAR mv = CALCULATE ( MEDIAN ( product_info[Reviews] ), ALL ( product_info ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( product_info[Rating] ), "Non Noté",
			        product_info[Rating] >= mr && product_info[Reviews] >= mv, "Hero",
			        product_info[Rating] >= mr, "Hidden Gem",
			        product_info[Reviews] >= mv, "Risk",
			        "Underperformer"
			    )
		lineageTag: 0f0f6cf2-b135-4f22-928c-59b52509f644
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Price Tier' =
			
			SWITCH (
			    TRUE (),
			    product_info[price_usd] < 25, "Moins de 25 $",
			    product_info[price_usd] < 50, "25 – 50 $",
			    product_info[price_usd] < 100, "50 – 100 $",
			    "Plus de 100 $"
			)
		lineageTag: afcc8791-c581-4d4c-b245-7c2a1297f663
		summarizeBy: none
		sortByColumn: 'Price Tier Order'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Price Tier Order' =
			
			SWITCH (
			    TRUE (),
			    product_info[price_usd] < 25, 1,
			    product_info[price_usd] < 50, 2,
			    product_info[price_usd] < 100, 3,
			    4
			)
		formatString: 0
		lineageTag: b9cb0759-1d28-4721-b93c-70d72277d1dd
		summarizeBy: none

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Rating Band' =
			
			SWITCH (
			    TRUE (),
			    ISBLANK ( product_info[Rating] ), "Non Noté",
			    product_info[Rating] < 3, "Moins de 3,0★",
			    product_info[Rating] < 3.5, "3,0 – 3,5★",
			    product_info[Rating] < 4, "3,5 – 4,0★",
			    product_info[Rating] < 4.5, "4,0 – 4,5★",
			    "4,5 – 5,0★"
			)
		lineageTag: abdcb48a-1ee8-44a0-8264-31e455ac8509
		summarizeBy: none
		sortByColumn: 'Rating Band Order'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Rating Band Order' =
			
			SWITCH (
			    TRUE (),
			    ISBLANK ( product_info[Rating] ), 0,
			    product_info[Rating] < 3, 1,
			    product_info[Rating] < 3.5, 2,
			    product_info[Rating] < 4, 3,
			    product_info[Rating] < 4.5, 4,
			    5
			)
		formatString: 0
		lineageTag: 01700133-3895-4a80-9b17-378df49a7864
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition product_info = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\Bonita\Desktop\07_Portfolio\00_Dataset\Sephora Products and Skincare Reviews\Data Source\product_info.csv"),[Delimiter=",", Columns=27, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Use First Row as Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type All" = Table.TransformColumnTypes(#"Use First Row as Headers", {
				        {"product_id", type text},
				        {"product_name", type text},
				        {"brand_id", type text},
				        {"brand_name", type text},
				        {"loves_count", Int64.Type},
				        {"rating", type number},
				        {"reviews", Int64.Type},
				        {"size", type text},
				        {"variation_type", type text},
				        {"variation_value", type text},
				        {"variation_desc", type text},
				        {"ingredients", type text},
				        {"price_usd", type number},
				        {"value_price_usd", type number},
				        {"sale_price_usd", type number},
				        {"limited_edition", Int64.Type},
				        {"new", Int64.Type},
				        {"online_only", Int64.Type},
				        {"out_of_stock", Int64.Type},
				        {"sephora_exclusive", Int64.Type},
				        {"highlights", type text},
				        {"primary_category", type text},
				        {"secondary_category", type text},
				        {"tertiary_category", type text},
				        {"child_count", Int64.Type},
				        {"child_max_price", type number},
				        {"child_min_price", type number}
				    }, "en-US"),
				    #"Renamed Columns" = Table.RenameColumns(#"Changed Type All",{{"primary_category", "Primary Category"}, {"brand_name", "Brand Name"}, {"reviews", "Reviews"}, {"rating", "Rating"}, {"product_name", "Product Name"}}),
				    // Version française : noms des catégories traduits
				    CategoriesFR = [#"Skincare" = "Soin", #"Makeup" = "Maquillage", #"Hair" = "Cheveux", #"Fragrance" = "Parfum", #"Bath & Body" = "Bain & Corps", #"Mini Size" = "Formats Mini", #"Men" = "Homme", #"Tools & Brushes" = "Accessoires & Pinceaux", #"Gifts" = "Cadeaux"],
				    #"Translated Categories" = Table.TransformColumns(#"Renamed Columns", {{"Primary Category", each Record.FieldOrDefault(CategoriesFR, _, _), type text}})
				in
				    #"Translated Categories"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

