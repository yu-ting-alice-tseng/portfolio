	column 'Skincare Rating Band' =
			
			SWITCH (
			    TRUE (),
			    ISBLANK ( reviews[rating] ), "Non Noté",
			    reviews[rating] < 3, "Moins de 3,0★",
			    reviews[rating] < 3.5, "3,0 – 3,5★",
			    reviews[rating] < 4, "3,5 – 4,0★",
			    reviews[rating] < 4.5, "4,0 – 4,5★",
			    "4,5 – 5,0★"
			)
		lineageTag: 35b789f7-bbd5-4414-96f9-f6fddfcd59dd
		summarizeBy: none
		sortByColumn: 'Skincare Rating Band Order'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Skincare Rating Band Order' =
			
			SWITCH (
			    TRUE (),
			    ISBLANK ( reviews[rating] ), 0,
			    reviews[rating] < 3, 1,
			    reviews[rating] < 3.5, 2,
			    reviews[rating] < 4, 3,
			    reviews[rating] < 4.5, 4,
			    5
			)
		formatString: 0
		lineageTag: 7366df93-0440-4172-8d08-5e2908fc3cf9
		summarizeBy: sum

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	partition reviews = m
		mode: import
		source = ```
				let
				    // 1. 讀取資料夾裡的所有檔案，排除隱藏檔
				    Source = Folder.Files("C:\Users\Bonita\Desktop\07_Portfolio\00_Dataset\Sephora Products and Skincare Reviews\Data Source\reviews"),
				    #"Filtered Hidden Files1" = Table.SelectRows(Source, each [Attributes]?[Hidden]? <> true),
				
				    // 2. 對每個檔案套用 Transform File（已設好標題列、已刪除列號欄）
				    #"Invoke Custom Function1" = Table.AddColumn(#"Filtered Hidden Files1", "Transform File", each #"Transform File"([Content])),
				    #"Renamed Columns1" = Table.RenameColumns(#"Invoke Custom Function1", {"Name", "Source.Name"}),
				    #"Removed Other Columns1" = Table.SelectColumns(#"Renamed Columns1", {"Source.Name", "Transform File"}),
				
				    // 3. 展開成一張表，Source.Name 保留檔名
				    #"Expanded Table Column1" = Table.ExpandTableColumn(#"Removed Other Columns1", "Transform File", Table.ColumnNames(#"Transform File"(#"Sample File"))),
				
				    // 4. 刪除 product_info 已有的欄位
				    #"Removed Columns" = Table.RemoveColumns(#"Expanded Table Column1", {"product_name", "brand_name", "price_usd"}),
				
				    // 5. 設定類型，固定用 en-US 解讀小數與日期
				    #"Changed Type All" = Table.TransformColumnTypes(#"Removed Columns", {
				        {"Source.Name", type text},
				        {"author_id", type text},
				        {"rating", Int64.Type},
				        {"is_recommended", Int64.Type},
				        {"helpfulness", type number},
				        {"total_feedback_count", Int64.Type},
				        {"total_neg_feedback_count", Int64.Type},
				        {"total_pos_feedback_count", Int64.Type},
				        {"submission_time", type date},
				        {"review_text", type text},
				        {"review_title", type text},
				        {"skin_tone", type text},
				        {"eye_color", type text},
				        {"skin_type", type text},
				        {"hair_color", type text},
				        {"product_id", type text}
				    }, "en-US"), 
				
				    // 6. 把評論標題和內容合併成小寫文字，方便搜尋關鍵字
				    #"Added Text" = Table.AddColumn(#"Changed Type All", "text_lower",
				        each Text.Lower(Text.Combine({[review_title], [review_text]}, " ")), type text),
				
				    // 7. 定義主題和對應的關鍵字
				    Themes = {
				        {"theme_irritation", {"irritat", "burn", "breakout", "broke me out", "broke out", "rash", "sting", "redness", "allerg", "reaction"}},
				        {"theme_texture", {"sticky", "greasy", "oily", "heavy", "tacky", "pilling", "pills", "residue"}},
				        {"theme_scent", {"smell", "scent", "fragrance", "odor", "stink"}},
				        {"theme_price", {"price", "expensive", "overpriced", "worth", "money", "cost"}},
				        {"theme_packaging", {"packag", "pump", "bottle", "jar", "leak", "broken", "tube"}},
				        {"theme_no_results", {"didn't work", "didn’t work", "didnt work", "did not work", "not work", "no difference", "no results", "did nothing", "didn't do", "didn’t do"}},
				        {"theme_hydration", {"hydrat", "moistur", "dry"}}
				    },
				
				    // 8. 每個主題新增一欄：評論有提到任一關鍵字就是 1，否則是 0
				    #"Added Themes" = List.Accumulate(Themes, #"Added Text",
				        (tbl, th) => Table.AddColumn(tbl, th{0},
				            (row) => if List.AnyTrue(List.Transform(th{1}, (k) => Text.Contains(row[text_lower], k))) then 1 else 0,
				            Int64.Type)),
				
				    // 9. 刪掉暫時用的小寫文字欄，減少檔案大小
				    #"Removed Text" = Table.RemoveColumns(#"Added Themes", {"text_lower"})
				in
				    #"Removed Text"
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

