  <dashboards>
    <dashboard name="Funnel and Retention">
      <style>
        <style-rule element='table'>
          <format attr='background-color' value="#E4ECE7" />
        </style-rule>
      </style>
      <size maxheight='2120' maxwidth='1200' minheight='2120' minwidth='1200' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='4528' id='3' w='97333' x='1333' y='377' type-v2='text'>
            <formatted-text>
              <run fontcolor="#16211F" fontname="Georgia" fontsize='22'>Beauty E-commerce: Conversion Funnel, Cart Abandonment and Retention</run>
              <run>Æ&#10;</run>
              <run fontcolor="#44524F" fontname="Segoe UI" fontsize='11'>20.7M events · 10/2019 – 02/2020 · analysed in SQL on BigQuery</run>
            </formatted-text>
            <zone-style>
              <format attr='margin' value='2' />
              <format attr='padding' value='4' />
              <format attr='background-color' value="#E4ECE7" />
            </zone-style>
          </zone>
          <zone h='5660' id='4' w='24333' x='1333' y='5094' type-v2='text'>
            <formatted-text>
              <run fontcolor="#0D9488" fontname="Georgia" fontsize='30'>1.67%</run>
              <run>Æ&#10;</run>
              <run fontcolor="#44524F" fontname="Segoe UI" fontsize='11'>of visits buy in a single session</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value="#C3CFC9" />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='6' />
              <format attr='padding' value='12' />
              <format attr='background-color' value="#F7FAF8" />
            </zone-style>
          </zone>
          <zone h='5660' id='5' w='24333' x='25667' y='5094' type-v2='text'>
            <formatted-text>
              <run fontcolor="#0D9488" fontname="Georgia" fontsize='30'>15.6%</run>
              <run>Æ&#10;</run>
              <run fontcolor="#44524F" fontname="Segoe UI" fontsize='11'>of abandoned items are bought back later</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value="#C3CFC9" />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='6' />
              <format attr='padding' value='12' />
              <format attr='background-color' value="#F7FAF8" />
            </zone-style>
          </zone>
          <zone h='5660' id='6' w='24333' x='50000' y='5094' type-v2='text'>
            <formatted-text>
              <run fontcolor="#0D9488" fontname="Georgia" fontsize='30'>43%</run>
              <run>Æ&#10;</run>
              <run fontcolor="#44524F" fontname="Segoe UI" fontsize='11'>of brand traffic goes to “leak” brands</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value="#C3CFC9" />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='6' />
              <format attr='padding' value='12' />
              <format attr='background-color' value="#F7FAF8" />
            </zone-style>
          </zone>
          <zone h='5660' id='7' w='24333' x='74333' y='5094' type-v2='text'>
            <formatted-text>
              <run fontcolor="#0D9488" fontname="Georgia" fontsize='30'>21.0%</run>
              <run>Æ&#10;</run>
              <run fontcolor="#44524F" fontname="Segoe UI" fontsize='11'>of new customers buy again within 60 days</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value="#C3CFC9" />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='6' />
              <format attr='padding' value='12' />
              <format attr='background-color' value="#F7FAF8" />
            </zone-style>
          </zone>
          <zone h='4906' id='8' w='97333' x='1333' y='11132' type-v2='text'>
            <formatted-text>
              <run fontcolor="#0D9488" fontname="Georgia" fontsize='18'>1</run>
              <run fontcolor="#16211F" fontname="Georgia" fontsize='17'>   Most Purchases Take Several Visits</run>
              <run>Æ&#10;</run>
              <run fontcolor="#44524F" fontname="Segoe UI" fontsize='11'>Only 46% of orders follow view, cart, purchase in the same session. Of the abandoned items bought back later, 52.6% come back within 24 hours: a cart reminder belongs in that window.</run>
            </formatted-text>
            <zone-style>
              <format attr='margin' value='2' />
              <format attr='padding' value='4' />
              <format attr='background-color' value="#E4ECE7" />
            </zone-style>
          </zone>
          <zone h='13208' id='9' w='48667' x='1333' y='16226' name="Funnel" show-title='true'>
            <zone-style>
              <format attr='border-color' value="#C3CFC9" />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='6' />
              <format attr='padding' value='8' />
              <format attr='background-color' value="#F7FAF8" />
            </zone-style>
          </zone>
          <zone h='13208' id='10' w='48667' x='50000' y='16226' name="Cart Recovery" show-title='true'>
            <zone-style>
              <format attr='border-color' value="#C3CFC9" />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='6' />
              <format attr='padding' value='8' />
              <format attr='background-color' value="#F7FAF8" />
            </zone-style>
          </zone>
          <zone h='4906' id='11' w='97333' x='1333' y='29811' type-v2='text'>
            <formatted-text>
              <run fontcolor="#0D9488" fontname="Georgia" fontsize='18'>2</run>
              <run fontcolor="#16211F" fontname="Georgia" fontsize='17'>   Leak Brands: 43% of Traffic, 1.53% Conversion</run>
              <run>Æ&#10;</run>
              <run fontcolor="#44524F" fontname="Segoe UI" fontsize='11'>180 brands split at the median traffic (5,146 sessions) and conversion (1.886%). If leaks converted like stars (2.40%), their purchases would go from about 23,900 to 37,400 (+56%, a what-if, not a forecast). grattol sits on the median.</run>
            </formatted-text>
            <zone-style>
              <format attr='margin' value='2' />
              <format attr='padding' value='4' />
              <format attr='background-color' value="#E4ECE7" />
            </zone-style>
          </zone>
          <zone h='19811' id='12' w='97333' x='1333' y='34906' name="Brand Matrix" show-title='true'>
            <zone-style>
              <format attr='border-color' value="#C3CFC9" />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='6' />
              <format attr='padding' value='8' />
              <format attr='background-color' value="#F7FAF8" />
            </zone-style>
          </zone>
          <zone h='4906' id='13' w='97333' x='1333' y='55094' type-v2='text'>
            <formatted-text>
              <run fontcolor="#0D9488" fontname="Georgia" fontsize='18'>3</run>
              <run fontcolor="#16211F" fontname="Georgia" fontsize='17'>   Late-November Peak, New Year Low</run>
              <run>Æ&#10;</run>
              <run fontcolor="#44524F" fontname="Segoe UI" fontsize='11'>6 of the 10 best days fall between 21 and 29/11/2019: traffic +32%, conversion +1.6 pts. 31/12 is the weakest day of the period.</run>
            </formatted-text>
            <zone-style>
              <format attr='margin' value='2' />
              <format attr='padding' value='4' />
              <format attr='background-color' value="#E4ECE7" />
            </zone-style>
          </zone>
          <zone h='14151' id='14' w='97333' x='1333' y='60189' name="Daily Revenue" show-title='true'>
            <zone-style>
              <format attr='border-color' value="#C3CFC9" />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='6' />
              <format attr='padding' value='8' />
              <format attr='background-color' value="#F7FAF8" />
            </zone-style>
          </zone>
          <zone h='4906' id='15' w='97333' x='1333' y='74717' type-v2='text'>
            <formatted-text>
              <run fontcolor="#0D9488" fontname="Georgia" fontsize='18'>4</run>
              <run fontcolor="#16211F" fontname="Georgia" fontsize='17'>   Retention and First Basket</run>
              <run>Æ&#10;</run>
              <run fontcolor="#44524F" fontname="Segoe UI" fontsize='11'>About 9% of new customers buy again the next month. A first basket of 5+ items goes with twice the repeat rate (25.4% vs 11.9%): a correlation, to be tested.</run>
            </formatted-text>
            <zone-style>
              <format attr='margin' value='2' />
              <format attr='padding' value='4' />
              <format attr='background-color' value="#E4ECE7" />
            </zone-style>
          </zone>
          <zone h='13208' id='16' w='48667' x='1333' y='79811' name="Cohorts" show-title='true'>
            <zone-style>
              <format attr='border-color' value="#C3CFC9" />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='6' />
              <format attr='padding' value='8' />
              <format attr='background-color' value="#F7FAF8" />
            </zone-style>
          </zone>
          <zone h='13208' id='17' w='48667' x='50000' y='79811' name="First Basket" show-title='true'>
            <zone-style>
              <format attr='border-color' value="#C3CFC9" />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='6' />
              <format attr='padding' value='8' />
              <format attr='background-color' value="#F7FAF8" />
            </zone-style>
          </zone>
          <zone h='4340' id='18' w='97333' x='1333' y='93396' type-v2='text'>
            <formatted-text>
              <run fontcolor="#16211F" fontname="Georgia" fontsize='13'>Data Limits</run>
              <run>Æ&#10;</run>
              <run fontcolor="#44524F" fontname="Segoe UI" fontsize='10'>Brand known for about 57% of purchases, no categories (98% empty). No order id: one session with a purchase = one order. Times in UTC, currency not stated. Cohort 10/2019 (*) overstated: the data starts that month. Correlations only, no experiment.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value="#C3CFC9" />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='6' />
              <format attr='padding' value='10' />
              <format attr='background-color' value="#F7FAF8" />
            </zone-style>
          </zone>
          <zone h='1698' id='19' w='97333' x='1333' y='97925' type-v2='text'>
            <formatted-text>
              <run fontcolor="#44524F" fontname="Segoe UI" fontsize='9'>Data source: Kaggle “eCommerce Events History in Cosmetics Shop” (10/2019 – 02/2020) · Personal project · Yu-Ting Tseng</run>
            </formatted-text>
            <zone-style>
              <format attr='margin' value='2' />
              <format attr='padding' value='4' />
              <format attr='background-color' value="#E4ECE7" />
            </zone-style>
          </zone>
        </zone>
      </zones>
      <simple-id uuid="{F6A66B0B-C981-5350-819D-97C57FFD6426}" />
    </dashboard>
  </dashboards>
