            <column-instance column="[chart]" derivation="None" name="[none:chart:nk]" pivot='key' type="nominal" />
            <column-instance column="[label_en]" derivation="None" name="[none:label_en:nk]" pivot='key' type="nominal" />
            <column-instance column="[series_en]" derivation="None" name="[none:series_en:nk]" pivot='key' type="nominal" />
