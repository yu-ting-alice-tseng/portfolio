            <column-instance column="[sort_key]" derivation="Min" name="[min:sort_key:qk]" pivot='key' type="quantitative" />
          </datasource-dependencies>
          <filter class='categorical' column="[federated.beauty_main].[none:chart:nk]">
            <groupfilter function='member' level="[none:chart:nk]" member='"funnel"' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <sort class='computed' column="[federated.beauty_main].[none:label_en:nk]" direction='ASC' using="[federated.beauty_main].[min:sort_key:qk]" />
